# Server
PORT=3001
NODE_ENV=production
BASE_URL=http://82.26.94.231
# Comma-separated list of extra allowed CORS origins (optional)
CORS_ORIGINS=

# Database
DB_PATH=./data/orders.db

# Admin authentication
ADMIN_USERNAME=admin
# bcrypt hash of password. Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$...
# Static token for admin API requests
ADMIN_TOKEN=change-this-to-a-long-random-string

# JWT for client authentication
JWT_SECRET=change-this-to-another-long-random-string

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# VK notifications (optional)
VK_BOT_TOKEN=...
VK_PEER_ID=...

# Max messenger notifications (optional)
MAX_BOT_TOKEN=...
MAX_CHAT_ID=...
